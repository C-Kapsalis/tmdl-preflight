table 'f-Filters'
	lineageTag: b97b6d4d-3896-5edd-a477-8e9905827885

	measure 'f-All' =
			VAR all_cats = CONCATENATEX(VALUES('z-Map Dimension-Measure Groupings'[Analysis Category]), [Analysis Category], ",")
			VAR temp_basic =
			    IF(CONTAINSSTRING(all_cats, "Spend"), IF([f-Spend] > 0, TRUE(), FALSE()), TRUE())
			    && IF(CONTAINSSTRING(all_cats, "Beans"), IF([f-Beans] > 0, TRUE(), FALSE()), TRUE())
			    && IF(CONTAINSSTRING(all_cats, "Tea"), IF([f-Roast] > 0, TRUE(), FALSE()), TRUE())
			VAR temp_alt =
			    IF(CONTAINSSTRING(all_cats, "Spend"), IF([f-Spend] > 0, TRUE(), FALSE()), FALSE())
			    || IF(CONTAINSSTRING(all_cats, "Tea"), IF([f-Roast] > 0, TRUE(), FALSE()), FALSE())
			RETURN
			    IF(temp_basic || temp_alt, 1, 0)
		lineageTag: 169885ad-b981-5da3-9ffd-508d6ab7cffd

	measure 'f-Spend' = COUNTROWS(Beans)
		lineageTag: 43563f46-9a79-5259-92c3-f4be48dd7362

	measure 'f-Beans' = COUNTROWS(Beans)
		lineageTag: 3b802558-cbbe-5ee4-b7fa-a6ae07d89229

	measure 'f-Email_Marketing_Lists' = COUNTROWS(Mailings)
		lineageTag: a8dee25b-cef0-5d8b-92ee-d8261a829cd3

	partition f-Filters = calculated
		mode: import
		source = ROW("x", 1)
