	column 'Session Key' = LOOKUPVALUE('MCP Tool Calls'[session_id], 'MCP Tool Calls'[id], 'MCP Feedback'[last_tool_call_id])
		dataType: int64
		lineageTag: 3f6bad65-2f28-518b-b2f8-a2903dfedd9d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Analysis Category at Submit' =
			VAR SubmittedAt = 'MCP Feedback'[created_at]
			VAR LastCall = TOPN(1, FILTER('MCP Tool Calls', 'MCP Tool Calls'[session_id] = 'MCP Feedback'[Session Key] && 'MCP Tool Calls'[created_at] < SubmittedAt && NOT ISBLANK('MCP Tool Calls'[Analysis Category])), 'MCP Tool Calls'[created_at], DESC, 'MCP Tool Calls'[id], DESC)
			RETURN MAXX(LastCall, 'MCP Tool Calls'[Analysis Category])
		dataType: string
		lineageTag: a667279f-c2f6-5ff1-9fa8-618902d5de58
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'MCP Feedback' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(Warehouse, "select * from feedback")
				in
				    Source
