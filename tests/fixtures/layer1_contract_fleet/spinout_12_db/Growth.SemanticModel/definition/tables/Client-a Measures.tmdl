table 'Client-a Measures'
	lineageTag: 5eed0000-0000-0000-0000-00000000011c

	/// True when the current filter cannot reach the fact.
	measure '-helper Slicer Cannot Reach Users' = ```
			VAR _miss =
			    ISFILTERED ( '_Accounts' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Accounts'[account_id] ) )
			    || ISFILTERED ( '_Ads' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Ads'[ad_id] ) )
			    || ISFILTERED ( '_Assets' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Assets'[asset_id] ) )
			    || ISFILTERED ( '_Campaigns' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Campaigns'[ad_group_x_id] ) )
			    || ISFILTERED ( '_Content' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Content'[content_group_id] ) )
			    || ISFILTERED ( '_Countries' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Countries'[country_id] ) )
			    || ISFILTERED ( '_Devices' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Devices'[device_id] ) )
			    || ISFILTERED ( '_Keywords' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Keywords'[keyword_id] ) )
			    || ISFILTERED ( '_Landing Pages' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Landing Pages'[landing_page_x_id] ) )
			    || ISFILTERED ( '_Offers' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Offers'[offer_id] ) )
			    || ISFILTERED ( '_Queries' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Queries'[query_id] ) )
			    || ISFILTERED ( '_Users' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Users'[user_id] ) )
			    || ISFILTERED ( '_Cluster Mappings' ) && NOT CALCULATE ( COUNTROWS ( 'User Views' ), REMOVEFILTERS (), VALUES ( '_Cluster Mappings'[Cluster Value] ) )
			RETURN _miss
			```
		lineageTag: 5eed0000-0000-0000-0000-00000000011d

