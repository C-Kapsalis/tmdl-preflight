	/// Spend.
	measure Cost = SUM ( 'Ads Report'[cost] )
		lineageTag: 5eed0000-0000-0000-0000-000000000125

	/// Spend, cost-layer masked.
	measure '^Cost' = CALCULATE ( [Cost] )
		lineageTag: 5eed0000-0000-0000-0000-000000000126

	/// Accounts on the selected attribution basis.
	measure 'Accounts #' = ```
			VAR _basis = SELECTEDVALUE ( 'z-Selector Attribution Basis'[Basis], "00. Measured" )
			RETURN IF ( [-helper Slicer Cannot Reach Users], BLANK (), DISTINCTCOUNT ( 'Subscriptions'[user_id] ) )
			```
		lineageTag: 5eed0000-0000-0000-0000-000000000127

	/// New clients on the selected attribution basis.
	measure 'New Clients #' = ```
			VAR _basis = SELECTEDVALUE ( 'z-Selector Attribution Basis'[Basis], "00. Measured" )
			RETURN IF ( [-helper Slicer Cannot Reach Transactions], BLANK (), CALCULATE ( COUNTROWS ( Subscriptions ), Subscriptions[has_new] > 0 ) )
			```
		lineageTag: 5eed0000-0000-0000-0000-000000000128

	/// Population count.
	measure 'Paying Subscriptions from New Accounts #' = ```
			IF ( [-helper Slicer Cannot Reach Users], BLANK (), COUNTROWS ( Subscriptions ) )
			```
		lineageTag: 5eed0000-0000-0000-0000-000000000129

	/// Population count.
	measure 'Trial Starts from New Accounts #' = ```
			IF ( [-helper Slicer Cannot Reach Users], BLANK (), COUNTROWS ( Subscriptions ) )
			```
		lineageTag: 5eed0000-0000-0000-0000-00000000012a

	/// Population count.
	measure 'Never Started from New Accounts #' = ```
			IF ( [-helper Slicer Cannot Reach Users], BLANK (), COUNTROWS ( Subscriptions ) )
			```
		lineageTag: 5eed0000-0000-0000-0000-00000000012b

	/// Cost per count, blank outside the enhanced window.
	measure 'Cost/ New Client' = ```
			IF ( [-helper Enhanced Window Unallocated], BLANK (),
			    IF ( [-helper Cost Grain Valid], DIVIDE ( [Cost], [New Clients #] ) ) )
			```
		lineageTag: 5eed0000-0000-0000-0000-00000000012c

	/// Cost per count, blank outside the enhanced window.
	measure '^Cost/ New Client' = ```
			IF ( [-helper Enhanced Window Unallocated], BLANK (),
			    IF ( [-helper Cost Grain Valid], DIVIDE ( [^Cost], [New Clients #] ) ) )
			```
		lineageTag: 5eed0000-0000-0000-0000-00000000012d

	/// Cost per count, blank outside the enhanced window.
	measure 'Cost/ Account' = ```
			IF ( [-helper Enhanced Window Unallocated], BLANK (),
			    IF ( [-helper Cost Grain Valid], DIVIDE ( [Cost], [Accounts #] ) ) )
			```
		lineageTag: 5eed0000-0000-0000-0000-00000000012e

	/// Cost per count, blank outside the enhanced window.
	measure '^Cost/ Account' = ```
			IF ( [-helper Enhanced Window Unallocated], BLANK (),
			    IF ( [-helper Cost Grain Valid], DIVIDE ( [^Cost], [Accounts #] ) ) )
			```
		lineageTag: 5eed0000-0000-0000-0000-00000000012f

	/// True when the window starts before the enhanced allocation.
	measure '-helper Enhanced Window Unallocated' = ```
			VAR _basis = SELECTEDVALUE ( 'z-Selector Attribution Basis'[Basis], "00. Measured" )
			RETURN
			    SWITCH ( TRUE (),
			        _basis = "00. Measured", FALSE (),
			        MIN ( '__Calendar'[Date] ) < [-helper Enhanced Allocation Start] )
			```
		lineageTag: 5eed0000-0000-0000-0000-000000000130

	/// First date carrying an enhanced allocation.
	measure '-helper Enhanced Allocation Start' = ```
			CALCULATE ( MIN ( Subscriptions[event_date] ),
			    'z-Selector Attribution Basis'[Basis] = "01. Enhanced (allocated)",
			    FILTER ( VALUES ( Subscriptions[event_date] ), [Accounts #] > 0 ) )
			```
		lineageTag: 5eed0000-0000-0000-0000-000000000131

	/// False at grains where cost and the count do not scope together.
	measure '-helper Cost Grain Valid' = ```
			VAR blockedTables = ISFILTERED ( '_Offers' ) || ISFILTERED ( '_Accounts' ) || ISFILTERED ( '_Campaigns' ) || ISFILTERED ( '_Devices' ) || ISFILTERED ( '_Landing Pages' ) || ISFILTERED ( '_Keywords' ) || ISFILTERED ( '_Queries' ) || ISFILTERED ( '_Countries' ) || ISFILTERED ( '_Ads' ) || ISFILTERED ( '_Crawl' ) || ISFILTERED ( '_Assets' ) || ISFILTERED ( '_Competitors' ) || ISFILTERED ( '_Email Marketing Lists' ) || ISFILTERED ( '_FB Organic Comments' ) || ISFILTERED ( '_FB Organic Pages' ) || ISFILTERED ( '_FB Organic Posts' ) || ISFILTERED ( '_Youtube Channel' ) || ISFILTERED ( '_Youtube Playlist' ) || ISFILTERED ( '_Youtube Video' )
			VAR blockedCols = ISINSCOPE ( '_Campaigns'[campaign_name] ) || ISINSCOPE ( '_Devices'[device] ) || ISINSCOPE ( '_Countries'[country] )
			VAR blockedOwnedRate = ISINSCOPE ( '_Users'[segment] ) && SELECTEDVALUE ( '_Users'[segment] ) = "Gifted"
			RETURN NOT ( blockedTables || blockedCols || blockedOwnedRate )
			```
		lineageTag: 5eed0000-0000-0000-0000-000000000132

	/// Legacy form compared has_return] = 1; never compare a count flag to one.
	measure 'Flagged Subscriptions 01 #' = CALCULATE ( COUNTROWS ( Subscriptions ), Subscriptions[has_new] > 0 )
		lineageTag: 5eed0000-0000-0000-0000-000000000133

	/// Flagged subscriptions.
	measure 'Flagged Subscriptions 02 #' = CALCULATE ( COUNTROWS ( Subscriptions ), Subscriptions[has_new] = 0 )
		lineageTag: 5eed0000-0000-0000-0000-000000000134

	/// Flagged subscriptions.
	measure 'Flagged Subscriptions 03 #' = CALCULATE ( COUNTROWS ( Subscriptions ), Subscriptions[has_return] > 0 )
		lineageTag: 5eed0000-0000-0000-0000-000000000135

	/// Flagged subscriptions.
	measure 'Flagged Subscriptions 04 #' = CALCULATE ( COUNTROWS ( Subscriptions ), Subscriptions[has_return] = 0 )
		lineageTag: 5eed0000-0000-0000-0000-000000000136

	/// Flagged subscriptions.
	measure 'Flagged Subscriptions 05 #' = CALCULATE ( COUNTROWS ( Subscriptions ), Subscriptions[has_renewal] > 0 )
		lineageTag: 5eed0000-0000-0000-0000-000000000137

	/// Flagged subscriptions.
	measure 'Flagged Subscriptions 06 #' = CALCULATE ( COUNTROWS ( Subscriptions ), Subscriptions[has_renewal] = 0 )
		lineageTag: 5eed0000-0000-0000-0000-000000000138

	/// Flagged subscriptions.
	measure 'Flagged Subscriptions 07 #' = CALCULATE ( COUNTROWS ( Subscriptions ), Subscriptions[has_churn] = TRUE )
		lineageTag: 5eed0000-0000-0000-0000-000000000139

	/// Flagged subscriptions.
	measure 'Flagged Subscriptions 08 #' = CALCULATE ( COUNTROWS ( Subscriptions ), Subscriptions[has_churn] = FALSE() )
		lineageTag: 5eed0000-0000-0000-0000-00000000013a

	/// Flagged subscriptions.
	measure 'Flagged Subscriptions 09 #' = CALCULATE ( COUNTROWS ( Subscriptions ), Subscriptions[has_churn] = TRUE () )
		lineageTag: 5eed0000-0000-0000-0000-00000000013b

	/// Flagged subscriptions.
	measure 'Flagged Subscriptions 10 #' = CALCULATE ( COUNTROWS ( Subscriptions ), Subscriptions[has_limbo] = TRUE )
