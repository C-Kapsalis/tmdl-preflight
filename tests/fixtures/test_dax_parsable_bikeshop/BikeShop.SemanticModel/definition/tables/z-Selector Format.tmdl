table 'z-Selector Format'
	lineageTag: cac10130-4f01-5e7b-9597-f8870263b93c

	calculationGroup

		calculationItem Format = SELECTEDMEASURE()

			formatStringDefinition =
					SWITCH(
					    TRUE(),
					    CONTAINSSTRING(SELECTEDMEASURENAME(), "#"), "#,##0",
					    "#,##0.00"
					)

	column 'Format Choice'
		dataType: string
		lineageTag: ef809529-ab8b-591b-b55e-92b9e32b15d0
		summarizeBy: none
		sourceColumn: Format Choice

	partition 'z-Selector Format' = calculationGroup
		mode: import

