model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Sales","_Products","_Stores"]

ref table __Calendar
ref table _Products
ref table _Stores
ref table Sales
ref table 'Sales Measures'
ref table 'Metric Selector'
