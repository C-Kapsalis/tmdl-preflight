table '#Report Measures'
	lineageTag: 0000b4b1-0000-0000-0000-000000000040

	/// Total paid media cost.
	measure 'Total Cost' = SUM(Ads[cost])
		lineageTag: 0000b4b1-0000-0000-0000-00000000003c

	/// Attributed revenue.
	measure Revenue = SUM(Ads[revenue])
		lineageTag: 0000b4b1-0000-0000-0000-00000000003d

	/// Clicks counted as bags.
	measure Bags = SUM(Ads[clicks])
		lineageTag: 0000b4b1-0000-0000-0000-00000000003e

	measure '-helper Roast Window' = 1
		lineageTag: 0000b4b1-0000-0000-0000-00000000003f

	partition '#Report Measures' = calculated
		mode: import
		source = ROW("x", 1)

