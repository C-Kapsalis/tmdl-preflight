table 'Helper Measures'
	lineageTag: 0000b4b1-0000-0000-0000-00000000000f

	/// Paid drilldown compatibility.
	measure '-helper y-drilldown paid performance' = IF(ISINSCOPE('_Ads'[ad_id]), "non_compatible", "ok")
		isHidden
		lineageTag: 0000b4b1-0000-0000-0000-00000000000a

	/// GA4 cannot reach query/keyword rows.
	measure '-helper y-drilldown ga4 unreachable' = ISINSCOPE('_Queries'[query]) || ISINSCOPE(_Keywords[keyword])
		isHidden
		lineageTag: 0000b4b1-0000-0000-0000-00000000000b

	measure 'i-Row Count' = COUNTROWS(Ads)
		isHidden
		lineageTag: 0000b4b1-0000-0000-0000-00000000000c

	measure '-Visual Bar Color' = "#336699"
		isHidden
		lineageTag: 0000b4b1-0000-0000-0000-00000000000d

	measure '_Running Total' = 1
		isHidden
		lineageTag: 0000b4b1-0000-0000-0000-00000000000e

	partition 'Helper Measures' = calculated
		mode: import
		source = ROW("x", 1)

