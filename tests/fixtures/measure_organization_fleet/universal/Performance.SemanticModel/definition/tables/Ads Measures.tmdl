table 'Ads Measures'
	lineageTag: 0000b4b1-0000-0000-0000-000000000015

	/// Total paid clicks.
	measure 'Total Clicks' = SUM(Ads[clicks])
		lineageTag: 0000b4b1-0000-0000-0000-000000000012

	/// Click-through rate.
	measure 'CTR Rate' = DIVIDE([Total Clicks], 100)
		lineageTag: 0000b4b1-0000-0000-0000-000000000013

	measure '-Margin Base' = 1
		isHidden
		lineageTag: 0000b4b1-0000-0000-0000-000000000014

	partition 'Ads Measures' = calculated
		mode: import
		source = ROW("x", 1)

